set(MATRIX_BOARD "lckfb-esp32s3r8n8" CACHE STRING "ESP32 development-board profile")
if(NOT MATRIX_BOARD MATCHES "^[a-z0-9][a-z0-9-]*$")
    message(FATAL_ERROR "Invalid MATRIX_BOARD")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/catalog.json" MATRIX_CATALOG)
string(JSON MATRIX_BOARD_JSON ERROR_VARIABLE MATRIX_BOARD_ERROR GET "${MATRIX_CATALOG}" "${MATRIX_BOARD}")
if(MATRIX_BOARD_ERROR)
    message(FATAL_ERROR "Unsupported MATRIX_BOARD: ${MATRIX_BOARD}")
endif()
foreach(FIELD name target chipId project artifactSuffix flashBytes psramBytes)
    string(JSON MATRIX_BOARD_${FIELD} GET "${MATRIX_BOARD_JSON}" "${FIELD}")
endforeach()
if(DEFINED IDF_TARGET AND NOT IDF_TARGET STREQUAL MATRIX_BOARD_target)
    message(FATAL_ERROR "Selected board requires ${MATRIX_BOARD_target}; use a separate build directory")
endif()
set(IDF_TARGET "${MATRIX_BOARD_target}")
set(MATRIX_BOARD_DIR "${CMAKE_CURRENT_LIST_DIR}/${MATRIX_BOARD}")
if(NOT DEFINED SDKCONFIG)
    set(SDKCONFIG "${CMAKE_BINARY_DIR}/sdkconfig")
endif()
if(NOT DEFINED SDKCONFIG_DEFAULTS)
    set(SDKCONFIG_DEFAULTS "${CMAKE_SOURCE_DIR}/sdkconfig.defaults;${MATRIX_BOARD_DIR}/sdkconfig.defaults")
endif()
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/boards")
configure_file("${CMAKE_CURRENT_LIST_DIR}/common/board_identity.h.in" "${CMAKE_BINARY_DIR}/boards/board_identity.h" @ONLY)
string(JSON MATRIX_BOARD_JSON SET "${MATRIX_BOARD_JSON}" id "\"${MATRIX_BOARD}\"")
file(WRITE "${CMAKE_BINARY_DIR}/matrix-board.json" "${MATRIX_BOARD_JSON}\n")
